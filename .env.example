# Copy to .env for production (`npm run start` loads it). Not used by `npm run dev`.
# Defaults below are for the CERN VM (nginx in front, see DEPLOY.md "CERN VM").
HOST=127.0.0.1
PORT=3000
BODY_SIZE_LIMIT=64K
DB_PATH=data/checklist.db

# Public URL of the site. Required behind nginx/HTTPS, otherwise every form submission is rejected.
ORIGIN=https://btltestserver.cern.ch

# Who may reach the app:
#   login      = behind a reverse proxy (nginx on the CERN VM, NPMplus on TrueNAS); only the app's own login
#   cloudflare = Cloudflare Access must vouch for a @cern.ch email (fill in the two CF_ values)
ACCESS_MODE=login

# Behind nginx / NPMplus (ACCESS_MODE=login): take the real client IP from the proxy header.
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1

# Cloudflare Zero Trust → Access → Applications → your app (ACCESS_MODE=cloudflare only)
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=paste-the-application-audience-tag-here
